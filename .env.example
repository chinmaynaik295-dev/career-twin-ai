# CareerTwin AI Environment Variables

# Security
SECRET_KEY=careertwin-ai-hyper-secure-dev-secret-key-32chars-min!

# AI / LLM Providers
# Options: 'auto', 'gemini', 'openai', 'mock'
LLM_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gemini-1.5-flash

# Database (Optional - leaves blank to run resilient In-Memory Demo mode)
MONGODB_URL=
DATABASE_NAME=careertwin_db
FORCE_MOCK_DB=false

